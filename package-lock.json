{
  "name": "resume-chat-monorepo",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "resume-chat-monorepo",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@resume-chat/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/resume-chat": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/core": {
      "name": "@resume-chat/core",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "resume": "bin/resume.js"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/ui": {
      "name": "resume-chat",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@resume-chat/core": "^0.1.0"
      },
      "bin": {
        "resume-chat": "bin/resume-chat.js"
      },
      "engines": {
        "node": ">=18"
      }
    }
  }
}
